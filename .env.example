# ── UHEI environment ────────────────────────────────────────────────────────
# Copy to `.env` and adjust. No secrets are required: every data source this
# project uses is public and unauthenticated.

# ── API ─────────────────────────────────────────────────────────────────────
UHEI_ENVIRONMENT=development
UHEI_LOG_LEVEL=INFO

# Where the API reads trained artifacts from. Defaults to ./ml/models and
# ./ml/reports relative to the repository root.
# UHEI_MODELS_DIR=/absolute/path/to/ml/models
# UHEI_REPORTS_DIR=/absolute/path/to/ml/reports

# Browser origins permitted to call the API (comma separated).
UHEI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request guard rails.
UHEI_MAX_SCENARIOS=8

# ── Pipeline ────────────────────────────────────────────────────────────────
# Sent to NOAA, Overpass and NYISO so operators can identify the traffic.
# Please put a real contact address here before running a large rebuild.
UHEI_USER_AGENT=UHEI/1.0 (Urban Heat & Energy Intelligence Engine; research project)

# ── Frontend ────────────────────────────────────────────────────────────────
# Inlined into the client bundle at build time, so it must be set before
# `npm run build`, not at runtime.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
